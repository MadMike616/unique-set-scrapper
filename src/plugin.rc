    BEGIN
      VALUE "CompanyName", "MadMike"
      VALUE "FileDescription", "Transmutes one unique or set item into a chance at random runes."
      VALUE "FileVersion", "0.3.1"
      VALUE "InternalName", "unique-rune-cube"
      VALUE "OriginalFilename", "d2rl-unique-rune-cube.dll"
      VALUE "ProductName", "Unique/Set Scrapper"
      VALUE "ProductVersion", "0.3.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
